FROM ubuntu:24.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install NordVPN official Linux client
RUN apt-get update && \
    apt-get install -y curl wget gnupg ca-certificates && \
    wget -qO - https://repo.nordvpn.com/nordvpn/public_signing.key | gpg --dearmor -o /usr/share/keyrings/nordvpn.gpg && \
    echo "deb [signed-by=/usr/share/keyrings/nordvpn.gpg] https://repo.nordvpn.com/deb/nordvpn/debian stable main" > /etc/apt/sources.list.d/nordvpn.list && \
    apt-get update && \
    apt-get install -y nordvpn tinyproxy && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Configure tinyproxy
RUN sed -i 's/^Port .*/Port 8888/' /etc/tinyproxy/tinyproxy.conf && \
    sed -i 's/^Allow .*/Allow 0.0.0.0\/0/' /etc/tinyproxy/tinyproxy.conf && \
    sed -i 's/^# DisableViaHeader.*/DisableViaHeader Yes/' /etc/tinyproxy/tinyproxy.conf

COPY vpn/entrypoint-v2.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8888

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -sf --proxy http://127.0.0.1:8888 https://api.ipify.org || exit 1

ENTRYPOINT ["/entrypoint.sh"]
