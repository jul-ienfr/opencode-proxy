# OpenCode Configuration — contrat F-H4
# YAML (config.yaml) = source primaire; ENV (.env) = secrets only
# Secrets: OPENCODE_API_KEY, OPENCODE_PROXY, DASHBOARD_TOKEN, OPENCODE_GO_*, PROXY
# Tout le reste (ip_rotation, geo, models, routing) vit dans config.yaml

# Optional: Proxy server (http://proxy.abc.com:port)
OPENCODE_PROXY=

# API key for OpenCode service
OPENCODE_API_KEY=your-api-key-here

# Model mapping for routes
OPUS_MAP_MODEL=kimi-k2.6
SONNET_MAP_MODEL=glm-5.1
HAIKU_MAP_MODEL=minimax-m2.5

# Optional: Override server ports
# OPENCODE_HOST=0.0.0.0
# OPENCODE_PORT=4000  # API + web dashboard (single port)

# Key routing strategy when multiple API keys are configured (api_keys.json):
# round-robin (default) or failover (first enabled, non-paused key wins)
# API_KEY_ROUTING=round-robin

# Disable model-name mapping: pass model names through unchanged
# (only keyword-based custom routes are still matched)
# DISABLE_MAPPING=0

# Dashboard UI language (en | fr)
# PROXY_LANG=en

# Optional: Debug mode — logs full request/response bodies, headers, routing, cache, streaming
# Can also be toggled at runtime via POST /api/debug ({"enabled": true/false})
# OPENCODE_DEBUG=0

# Optional: Auto-enable "Use Balance" on OpenCode so Go falls back to Zen balance credits
# Set to 0 to disable the auto-toggle
# OPENCODE_GO_USE_BALANCE=1

# Optional: exact official-client face for the free leg (defaults = measured
# from the real 1.18.31 client redirected at a local capturer, 2026-09-18).
# Two ai-sdk bundles: provider-utils/4.0.23 on /chat/completions, 4.0.40 on
# /responses (both verified on the wire). Refresh after each client release.
# OPENCODE_OFFICIAL_UA=opencode/1.18.31 ai-sdk/provider-utils/4.0.23 runtime/bun/1.3.14
# OPENCODE_OFFICIAL_UA_RESPONSES=opencode/1.18.31 ai-sdk/provider-utils/4.0.40 runtime/bun/1.3.14
# OPENCODE_CLIENT_NAME=desktop
# OPENCODE_PROJECT=global
# OPENCODE_JA3=771,4865-4866-4867-49195-49199-49196-49200-52393-52392-49161-49171-49162-49172-156-157-47-53,0-65037-23-65281-10-11-35-16-5-13-18-51-45-43,29-23-24,0
# Kill-switch (fallback to a browser preset if the custom JA3 replay breaks):
# OPENCODE_TLS_IMPERSONATE=chrome131

# Security: dashboard auth token (RECOMMENDED for any deployment bound to 0.0.0.0).
# When set, sensitive endpoints (/api/config*, /api/vpn-config, /api/vpn/credentials,
# /api/vpn/import, /api/vpn/export, /api/requests/{id}) require the header:
#   X-Dashboard-Token: <token>
# Unset = endpoints stay open (legacy behavior).
# DASHBOARD_TOKEN=change-me
# Fail-closed when host 0.0.0.0 without token (audit F-H6):
#   DASHBOARD_REQUIRE_TOKEN=true → 403 on sensitive endpoints if DASHBOARD_TOKEN empty and host 0.0.0.0
#   Set to false to keep legacy open behavior during dev.
# DASHBOARD_REQUIRE_TOKEN=false

# Station VPN / rotation IP — primary source is config.yaml (section `ip_rotation`),
# NOT .env, except SERVER_COUNTRIES which is interpolated by docker-compose.yml
# via ${SERVER_COUNTRIES} (no inline fallback — fail-closed, audit F-H5).
# Generate it from the single source before `docker compose up`:
#   python scripts/make_credentials_env.py  # syncs SERVER_COUNTRIES from config.yaml → .env
# Key options:
#   station_count: 1-10 parallel gluetun stations
#   vpn_stack: wireguard | openvpn | auto
#   socks5_proxies: [{name, host, port, username?, password?, enabled}] static
#                   socks5 pool (proxy_mode=socks5, round-robin, no docker)
#   socks5_auto_rotate: true = rotate the socks5 proxy automatically
#   use_nordvpn_api: false | true — NordVPN API for country/server discovery
#   custom_ovpn_file: path of a custom .ovpn (uploaded via the dashboard)
#   server_countries: comma-separated list — single source is config.yaml (audit F-H5)
#     SERVER_COUNTRIES is read by docker-compose.yml via ${SERVER_COUNTRIES:?…}
#     — generate it from config.yaml before `docker compose up`:
#     python scripts/make_credentials_env.py  # syncs SERVER_COUNTRIES from config.yaml → .env
# SERVER_COUNTRIES=Germany,Netherlands,France,Spain,Poland,Sweden,Denmark,Finland,Norway,Belgium,Switzerland,Austria,Portugal,Italy,Ireland,United Kingdom,Czech Republic,Estonia,Latvia,Lithuania,Romania,Hungary,Greece,Slovakia,Slovenia,Croatia,Bulgaria,Luxembourg,Iceland,Cyprus,Malta,United States,Canada,Australia,Japan,Singapore
