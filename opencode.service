[Unit]
Description=OpenCode Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencode
Group=opencode
WorkingDirectory=/opt/opencode-proxy
ExecStart=/opt/opencode-proxy/.venv/bin/python opencode.py --no-gui
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/opencode-proxy/logs /opt/opencode-proxy/.env

[Install]
WantedBy=multi-user.target
