[Unit]
Description=OpenCode Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencode
Group=opencode
WorkingDirectory=/opt/opencode-proxy
# Prod: gunicorn (workers=cpu_count, UvicornWorker, keepalive 15, timeout 600)
# Dev: python opencode.py --no-gui (uvicorn direct, single worker)
ExecStart=/opt/opencode-proxy/.venv/bin/gunicorn -c gunicorn.conf.py opencode:app
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/opencode-proxy/logs /opt/opencode-proxy/.env

[Install]
WantedBy=multi-user.target
